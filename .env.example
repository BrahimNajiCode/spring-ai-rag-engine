# Copy to .env and fill in your values. Spring Boot 4 loads .env from the working directory.
POSTGRES_URL=jdbc:postgresql://localhost:5432/rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Google Gemini API key (used for both chat and embedding)
GEMINI_API_KEY=
PROJECT_ID=


# Optional model overrides (defaults are set in application.yaml)
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
